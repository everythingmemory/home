# The gateway's provider keys — read by the `gateway` service ONLY.
#
# OPTIONAL. The shipped local model needs no key and the stack starts without
# this file. It is how you switch to a provider (see conf/gateway.yaml):
# copy to gateway.env and fill in:
#   cp gateway.env.template gateway.env
#
# gateway.env is git-ignored — never commit real keys. No other service reads
# this file: the engine, its workers and the plugins never hold a provider key.
# conf/gateway.yaml names each key as `os.environ/NAME`; a route you add with a
# key of its own gets its line here.

# The OpenRouter route (conf/gateway.yaml) — with EMBEDDING_MODEL=
# text-embedding-3-small in local.env.
OPENROUTER_API_KEY=
