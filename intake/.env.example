# Folder Intake's settings (intake/docker-compose.yml reads intake/.env).
# cp intake/.env.example intake/.env, then fill it in. A value in the shell
# overrides the file's.

# Required: the project is intake-<INTAKE_NAME>, one per folder watched.
INTAKE_NAME=

# Required: the network of the stack to post to, <stack name>_ememory
# (COMPOSE_PROJECT_NAME in the stack's .env). docker network ls lists them.
EMEMORY_NETWORK=

# The folder to watch: an absolute path on this machine.
FOLDER=

# A client key, for a stack with AUTH_ENABLED=true (./e.sh client-key create).
EMEMORY_API_KEY=
