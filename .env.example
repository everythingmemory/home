# Everything Memory — the engine's settings file (copied to .env, never committed).
# Run ./e.sh init to fill it in.
# Every value is explained in the docs: https://everythingmemory.ai/docs/configuration/

# -----------------------------------
# Postgres
# -----------------------------------

# The engine's database. All required; ./e.sh init makes the password.
# Details: https://everythingmemory.ai/docs/configuration/database/

POSTGRES_DB=ememory
POSTGRES_USER=ememory
POSTGRES_PASSWORD=

# -----------------------------------
# Archive
# -----------------------------------

# The host folder that holds the encrypted archive. Required; ./e.sh init makes it.
# Details: https://everythingmemory.ai/docs/configuration/archive/

ARCHIVE_DIR=

# -----------------------------------
# Redis
# -----------------------------------

# The job queue's password. Required; ./e.sh init makes it.
# Details: https://everythingmemory.ai/docs/configuration/workers/

REDIS_PASSWORD=

# -----------------------------------
# Networking
# -----------------------------------

# Host ports and the stack's network name. Optional.
# Details: https://everythingmemory.ai/docs/configuration/workers/

#EMEMORY_PORT=8765
#CONSOLE_PORT=8766
#EMEMORY_NETWORK=ememory

# -----------------------------------
# Console sessions
# -----------------------------------

# How long a console sign-in lasts. Optional.
# Details: https://everythingmemory.ai/docs/operator-guide/the-console/

#CONSOLE_SESSION_IDLE=0
#CONSOLE_SESSION_MAX=30d

# -----------------------------------
# Authentication
# -----------------------------------

# Required: false = this machine only; true = keys from ./e.sh client-key create.
# Details: https://everythingmemory.ai/docs/configuration/authentication/

AUTH_ENABLED=false

# -----------------------------------
# Embeddings
# -----------------------------------

# The embedding endpoint and model. Both required; EMBEDDING_API_KEY optional.
# Details: https://everythingmemory.ai/docs/configuration/embeddings/

EMBEDDING_BASE_URL=http://gateway:4000/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=

# -----------------------------------
# Retrieval profiles
# -----------------------------------

# The profiles ingest and e_timeline run. Optional.
# Details: https://everythingmemory.ai/docs/configuration/profiles/

PIPELINE_PROFILE=retrieval_v1
TEMPORAL_PROFILE=timeline_v1

# -----------------------------------
# Workers and schedule
# -----------------------------------

# The workers' scheduled sweeps and concurrency. Optional.
# Details: https://everythingmemory.ai/docs/configuration/workers/

#MAINTENANCE_WORKER_MAX_JOBS=5
CRON_ENABLED=true

# -----------------------------------
# Archive store
# -----------------------------------

# The S3-compatible store the archive writes to. Bucket and key pair required; ./e.sh init makes the pair.
# Details: https://everythingmemory.ai/docs/configuration/archive/

ARCHIVE_ENABLED=true
ARCHIVE_ENDPOINT_URL=http://archive-store:8333
ARCHIVE_REGION=us-east-1
ARCHIVE_BUCKET=ememory-archive
ARCHIVE_PREFIX=
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=

# -----------------------------------
# Encryption key
# -----------------------------------

# The archive's encryption key. Required; ./e.sh init makes it. Keep a copy apart from the archive.
# Details: https://everythingmemory.ai/docs/configuration/archive/

ARCHIVE_KEY=

# -----------------------------------
# Vector store
# -----------------------------------

# Qdrant instead of pgvector. Optional; the key is required with the Qdrant overlay.
# Details: https://everythingmemory.ai/docs/configuration/vector-store/

#COMPOSE_FILE=docker-compose.yml:docker-compose.qdrant.yml
#QDRANT_API_KEY=
